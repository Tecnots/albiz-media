generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         Int                       @id @default(autoincrement())
  name                       String
  handle                     String                    @unique
  email                      String                    @unique
  password                   String
  title                      String
  avatar                     String
  role                       UserRole                  @default(NORMAL)
  verified                   Boolean                   @default(false)
  isPremium                  Boolean                   @default(false)
  hasStory                   Boolean                   @default(false)
  bio                        String?
  location                   String?
  country                    String?
  district                   String?
  city                       String?
  pincode                    String?
  website                    String?
  coverPhoto                 String?
  joinedDate                 String?
  followers                  String                    @default("0")
  followingCount             String                    @default("0")
  followersCount             Int                       @default(0)
  followingCountInt          Int                       @default(0)
  customDomain               String?                   @unique
  showBranding               Boolean                   @default(true)
  banned                     Boolean                   @default(false)
  banReason                  String?
  canPost                    Boolean                   @default(false)
  lastSeenAt                 DateTime?
  publicKey                  String?
  emailVerified              DateTime?
  verificationToken          String?
  verificationTokenExpiry    DateTime?
  resetPasswordToken         String?
  resetPasswordTokenExpiry   DateTime?
  twoFactorEnabled           Boolean                   @default(false)
  twoFactorEmailCode         String?
  twoFactorEmailCodeExpiry   DateTime?
  image                      String?
  deactivatedAt              DateTime?
  originalEmail              String?
  reactivationDate           DateTime?
  domainStatus               DomainStatus              @default(PENDING)
  domainToken                String?
  domainVerificationAttempts Int                       @default(0)
  domainLastCheckedAt        DateTime?
  domainVerifiedAt           DateTime?
  domainActivatedAt          DateTime?
  domainFailureReason        String?
  domainProviderId           String?
  circleWelcomeSeen          Boolean                   @default(true)
  notificationPrefs          Json?
  countryCode                String?
  countrySource              String?
  countryUpdatedAt           DateTime?
  gender                     String?
  birthYear                  Int?
  createdAt                  DateTime                  @default(now())
  sessionVersion             Int                       @default(1)
  accounts                   Account[]
  adCampaigns                AdCampaign[]              @relation("AdCampaignCreator")
  sentSuggestions            AuthorSuggestion[]        @relation("AdminSuggestions")
  receivedSuggestions        AuthorSuggestion[]        @relation("AuthorSuggestions")
  participantConversations   Conversation[]            @relation("ParticipantConversations")
  otherUserConversations     Conversation[]            @relation("OtherUserConversations")
  notifications              Notification[]            @relation("NotificationUser")
  posts                      Post[]
  postEngagements            PostEngagement[]
  postImpressions            PostImpression[]
  sessions                   Session[]
  stories                    Story[]
  storyLikes                 StoryLike[]
  storyViews                 StoryView[]
  storyPollVotes             StoryPollVote[]
  storyQuestionResponses     StoryQuestionResponse[]
  shorts                     Short[]
  customTabs                 UserCustomTab[]
  education                  UserEducation[]
  experience                 UserExperience[]
  followingRel               UserFollow[]              @relation("UserFollowers")
  followersRel               UserFollow[]              @relation("UserFollowing")
  highlights                 UserHighlight[]
  interests                  UserInterest[]
  mutedByUsers               UserMute[]                @relation("MutedUser")
  mutedUsers                 UserMute[]                @relation("MuterUser")
  postLikesRel               PostLike[]                @relation("PostLikeUser")
  postCommentsRel            PostComment[]             @relation("PostCommentUser")
  savedPostsRel              SavedPost[]               @relation("SavedPostUser")
  shortLikesRel              ShortLike[]               @relation("ShortLikeUser")
  savedShortsRel             SavedShort[]              @relation("SavedShortUser")
  shortCommentsRel           ShortComment[]            @relation("ShortCommentUser")
  blockedUsersRel            BlockedUser[]             @relation("UserBlocks")
  blockedByUsersRel          BlockedUser[]             @relation("BlockedByUsers")
  skills                     UserSkill[]
  circleUpgradeRequests      CircleUpgradeRequest[]
  editorAssignments          EditorSectionAssignment[] @relation("EditorAssignments")
  sentEditorNotes            EditorNote[]              @relation("EditorNotes")
  assignedPosts              Post[]                    @relation("AssignedEditorPosts")
  assignedShorts             Short[]                   @relation("AssignedAdminShorts")
  editorPreferences          EditorPreferences?        @relation("EditorPreferences")
  editorTemplates            EditorNoteTemplate[]      @relation("EditorTemplates")
  editorActivity             EditorActivity[]          @relation("EditorActivity")
  shortActivity              ShortActivity[]           @relation("ShortActivity")
  pushTokens                 PushToken[]
  verificationRequests       VerificationRequest[]
  contentReports             ContentReport[]           @relation("ReportedBy")
  resolvedReports            ContentReport[]           @relation("ResolvedBy")
  scheduledAlerts            ScheduledAlert[]          @relation("AlertRecipient")
  createdAlerts              ScheduledAlert[]          @relation("AlertCreator")
  campaigns                  EmailCampaign[]           @relation("CampaignCreator")
  campaignRecipients         EmailCampaignRecipient[]  @relation("CampaignRecipient")
  deviceSessions             UserDeviceSession[]
  auditLogsActed             AuditLog[]                @relation("AuditActor")
  auditLogsTargeted          AuditLog[]                @relation("AuditTarget")
  stripeCustomer             StripeCustomer?
  stripeSubscriptions        StripeSubscription[]
  stripeInvoices             StripeInvoice[]
  receivedNotifications      Notification[]            @relation("NotificationRecipient")
  sentMessages               Message[]                 @relation("MessageSender")
  socialConnections          SocialConnection[]
  collections                UserCollection[]
  sentInvites                UserInvite[]
  uploadedBlobs              BlobInfo[]                @relation("BlobUploader")
  unfollowEventsAsFollower   UserUnfollowEvent[]       @relation("UnfollowFollower")
  unfollowEventsAsFollowing  UserUnfollowEvent[]       @relation("UnfollowFollowing")

  @@index([domainStatus])
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id               Int              @id @default(autoincrement())
  userId           Int
  type             PostType
  content          String?
  title            String?
  description      String?
  date             String
  time             String?
  image            String?
  tags             String[]
  views            String           @default("0")
  likes            String           @default("0")
  comments         String           @default("0")
  shares           String           @default("0")
  // Integer mirrors of the display-string counters — used by the ranking engine
  likesCount       Int              @default(0)
  commentsCount    Int              @default(0)
  sharesCount      Int              @default(0)
  viewsCount       Int              @default(0)
  status           String           @default("published")
  featured         Boolean          @default(false)
  pinned           Boolean          @default(false)
  flagged          Boolean          @default(false)
  flagReason       String?
  slug             String?          @unique
  seoDescription   String?
  sectionId        Int?
  language         String           @default("en")
  createdAt        DateTime         @default(now())
  contentScope     String           @default("GLOBAL")
  countryCode      String?
  assignedEditorId Int?
  publishAt        DateTime?
  scheduleJobId    String?
  articleContent   ArticleContent?
  section          ArticleSection?  @relation(fields: [sectionId], references: [id])
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedEditor   User?            @relation("AssignedEditorPosts", fields: [assignedEditorId], references: [id])
  postComments     PostComment[]
  engagements      PostEngagement[]
  impressions      PostImpression[]
  postLikes        PostLike[]
  postShareEvents  PostShareEvent[]
  trendingScore    TrendingScore?
  savedPosts       SavedPost[]
  editorNotes      EditorNote[]
  editorActivity   EditorActivity[] @relation("PostEditorActivity")
  contentReports   ContentReport[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([status, flagged])
  @@index([countryCode])
}

model VisitorLog {
  id          Int      @id @default(autoincrement())
  country     String?
  countryCode String?
  city        String?
  lat         Float?
  lon         Float?
  page        String?
  device      String?
  referrer    String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model ArticleSection {
  id                Int                       @id @default(autoincrement())
  name              String
  slug              String                    @unique
  description       String?
  color             String                    @default("#525252")
  active            Boolean                   @default(true)
  createdAt         DateTime                  @default(now())
  workflowPresetId  Int?
  workflowPreset    WorkflowPreset?           @relation(fields: [workflowPresetId], references: [id])
  posts             Post[]
  editorAssignments EditorSectionAssignment[]
}

model WorkflowPreset {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  stages      String[]
  createdAt   DateTime         @default(now())
  sections    ArticleSection[]
}

model ArticleContent {
  id         Int      @id @default(autoincrement())
  postId     Int      @unique
  paragraphs String[]
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model PushToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id          Int               @id @default(autoincrement())
  type        NotificationType
  userId      Int
  recipientId Int               @default(1)
  time        String
  group       NotificationGroup
  unread      Boolean           @default(false)
  postPreview String?
  postImage   String?
  postId      Int?
  // Added so Shorts moderation transitions can notify the uploader the same
  // way Post/Article transitions notify the author — previously Notification
  // had no way to reference a Short at all (audit finding H-4). A second,
  // separate @@unique (rather than widening the existing one) so every
  // pre-existing `type_userId_recipientId_postId` upsert call site keeps
  // compiling unchanged.
  shortId     Int?
  message     String?
  user        User              @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  recipient   User              @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([type, userId, recipientId, postId])
  @@unique([type, userId, recipientId, shortId])
  @@index([recipientId, unread])
  @@index([userId])
}

model Conversation {
  id                Int       @id @default(autoincrement())
  userId            Int
  lastMessage       String
  time              String
  unreadCount       Int       @default(0)
  online            Boolean   @default(false)
  updatedAt         DateTime  @default(now()) @updatedAt
  typingUserId      Int?
  typingAt          DateTime?
  encryptionEnabled Boolean   @default(false)
  participantId     Int?
  participant       User?     @relation("ParticipantConversations", fields: [participantId], references: [id], onDelete: SetNull)
  user              User      @relation("OtherUserConversations", fields: [userId], references: [id], onDelete: Cascade)
  messages          Message[]

  // A conversation "view" is unique per (owner, other user). Enforced in the DB
  // so concurrent first-messages / multi-device sends can never create a
  // duplicate thread — creation goes through an upsert on this key.
  @@unique([participantId, userId])
}

model Message {
  id               Int          @id @default(autoincrement())
  conversationId   Int
  fromMe           Boolean
  text             String
  time             String
  senderId         Int          @default(1)
  status           String       @default("sent")
  encrypted        Boolean      @default(false)
  iv               String?
  msgIndex         Int          @default(0)
  ratchetPublicKey String?
  createdAt        DateTime     @default(now())
  attachmentName   String?
  attachmentSize   Int?
  attachmentType   String?
  attachmentUrl    String?
  deleted          Boolean      @default(false)
  edited           Boolean      @default(false)
  editedAt         DateTime?
  savedByUser      Int?
  // When the owner bookmarked this message — drives the Saved → Chats ordering.
  savedAt          DateTime?
  // Bumped automatically on every write (send/edit/delete/status change). The
  // conversation poll uses this so message-level changes propagate even though
  // they don't touch Conversation.updatedAt.
  updatedAt        DateTime     @default(now()) @updatedAt
  conversation     Conversation @relation(fields: [conversationId], references: [id])
  sender           User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, msgIndex])
  @@index([conversationId, id])
  @@index([conversationId, updatedAt])
  @@index([senderId])
  @@index([savedByUser, savedAt])
}

model Story {
  id                     Int                     @id @default(autoincrement())
  userId                 Int
  imageUrl               String
  textOverlay            String?
  textColor              String?
  textPosX               Float                   @default(50)
  textPosY               Float                   @default(50)
  textScale              Float                   @default(1)
  textRotation           Float                   @default(0)
  textOpacity            Float                   @default(1)
  textBackgroundColor    String?
  location               String?
  locationLat            Float?
  locationLng            Float?
  locationPlaceId        String?
  locPosX                Float                   @default(50)
  locPosY                Float                   @default(20)
  imgPosX                Float                   @default(0)
  imgPosY                Float                   @default(0)
  imgScale               Float                   @default(1)
  imgFit                 String                  @default("contain")
  textBold               Boolean                 @default(false)
  textItalic             Boolean                 @default(false)
  textAlign              String                  @default("center")
  stickers               Json?
  visibility             String                  @default("public")
  status                 String                  @default("published")
  views                  Int                     @default(0)
  likes                  Int                     @default(0)
  createdAt              DateTime                @default(now())
  expiresAt              DateTime
  shares                 Int                     @default(0)
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyLikes             StoryLike[]
  storyViews             StoryView[]
  storyPollVotes         StoryPollVote[]
  storyQuestionResponses StoryQuestionResponse[]

  @@index([status, expiresAt])
  @@index([userId, status, expiresAt])
}

model StoryView {
  id       Int      @id @default(autoincrement())
  storyId  Int
  userId   Int
  viewedAt DateTime @default(now())
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

model StoryLike {
  id      Int      @id @default(autoincrement())
  storyId Int
  userId  Int
  likedAt DateTime @default(now())
  story   Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

model StoryPollVote {
  id        Int      @id @default(autoincrement())
  storyId   Int
  stickerId String
  userId    Int
  option    Int
  votedAt   DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, stickerId, userId])
  @@index([storyId, stickerId])
}

// One private response per (story, question sticker, responder). Upserting
// on the unique key below is what makes a resubmission an update rather
// than a duplicate — visible only to the story's author via the insights
// endpoint, never to other viewers.
model StoryQuestionResponse {
  id          Int      @id @default(autoincrement())
  storyId     Int
  stickerId   String
  userId      Int
  answer      String
  respondedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, stickerId, userId])
  @@index([storyId, stickerId])
}

// Curated, self-hosted music library backing the Story music sticker's
// default provider (LocalLibraryProvider in app/lib/music/provider.ts).
// Audio files are uploaded through the existing /api/upload pipeline like
// any other media — this table just stores the resulting metadata.
model MusicTrack {
  id         Int      @id @default(autoincrement())
  title      String
  artist     String
  category   String
  durationMs Int
  audioUrl   String
  artworkUrl String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([category])
}

// Durable trending-score cache — the periodic "recompute-trending" job
// (lib/job-queue.ts) upserts this on a 5-15 minute cadence via computeScore()
// in trending mode. Replaces the live, unbounded per-request scoring that
// used to run in /api/explore/trending and the feed's trending injection.
// viewsSnapshot carries each run's Post.viewsCount forward so the next run
// can compute a real delta (view velocity) without a separate cache table.
model TrendingScore {
  id            Int      @id @default(autoincrement())
  postId        Int      @unique
  score         Float
  velocity      Float
  geoCluster    Float
  socialProof   Float
  viewsSnapshot Int      @default(0)
  computedAt    DateTime @default(now())
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([score])
  @@index([computedAt])
}

// Persistent translation cache — shared by Posts, Articles, and News (Articles
// and News are the same Post rows under contentType "article"). A row is
// valid as long as sourceHash still matches the current source text; on
// mismatch (content was edited) the cache is treated as a miss and
// re-translated, so there is no separate invalidation step to remember to
// call anywhere.
model Translation {
  id             Int      @id @default(autoincrement())
  contentType    String // "post" | "article"
  contentId      Int
  field          String // "title" | "description" | "content" | "paragraph:0", ...
  targetLanguage String
  sourceHash     String // sha256 of the exact source text this row was translated from
  sourceLanguage String? // detected by the translation provider
  translatedText String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([contentType, contentId, field, targetLanguage])
  @@index([contentType, contentId])
}

model TrendingTopic {
  id    Int    @id
  name  String
  posts String
  image String
}

model SavedCollection {
  id    Int    @id
  name  String
  count Int
  image String
}

model SavedPost {
  id           Int      @id @default(autoincrement())
  userId       Int
  postId       Int
  collectionId Int?
  createdAt    DateTime @default(now())
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user         User     @relation("SavedPostUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model UserCollection {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  image     String   @default("")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContentTopic {
  id       String  @id
  label    String
  selected Boolean @default(false)
}

model AnalyticsStat {
  id        Int     @id @default(autoincrement())
  label     String
  value     String
  change    Float
  up        Boolean
  sparkline Float[]
}

model ViewOverTime {
  id    Int    @id @default(autoincrement())
  date  String
  value Int
}

model TopPost {
  id    Int    @id
  title String
  views String
  likes String
  image String
}

model QuickSnapshot {
  id    Int    @id @default(autoincrement())
  label String
  value String
}

model AccountSetting {
  id    Int    @id @default(autoincrement())
  label String
  value String
}

model LanguageRegionSetting {
  id    Int    @id @default(autoincrement())
  label String
  value String
}

model UserExperience {
  id          Int    @id @default(autoincrement())
  userId      Int
  role        String
  company     String
  logo        String @default("")
  period      String
  description String @default("")
  order       Int    @default(0)
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserEducation {
  id     Int    @id @default(autoincrement())
  userId Int
  school String
  degree String
  period String
  logo   String @default("")
  order  Int    @default(0)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSkill {
  id     Int    @id @default(autoincrement())
  userId Int
  name   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model UserInterest {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model UserCustomTab {
  id      Int    @id @default(autoincrement())
  userId  Int
  title   String
  content String @default("")
  order   Int    @default(0)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserHighlight {
  id         Int      @id @default(autoincrement())
  userId     Int
  name       String
  cover      String   @default("")
  images     String[]
  storyCount Int      @default(0)
  order      Int      @default(0)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PostLike {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation("PostLikeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([createdAt])
  @@index([postId, createdAt])
  @@index([userId])
}

model ShortLike {
  id        Int      @id @default(autoincrement())
  shortId   Int
  userId    Int
  createdAt DateTime @default(now())
  short     Short    @relation(fields: [shortId], references: [id], onDelete: Cascade)
  user      User     @relation("ShortLikeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shortId, userId])
  @@index([createdAt])
  @@index([shortId, createdAt])
  @@index([userId])
}

model SavedShort {
  id           Int      @id @default(autoincrement())
  userId       Int
  shortId      Int
  collectionId Int?
  createdAt    DateTime @default(now())
  short        Short    @relation(fields: [shortId], references: [id], onDelete: Cascade)
  user         User     @relation("SavedShortUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shortId])
}

// Mirrors PostComment (including the one-level reply nesting) — Shorts
// previously had no comment system at all.
model ShortComment {
  id        Int            @id @default(autoincrement())
  shortId   Int
  userId    Int
  text      String
  parentId  Int?
  createdAt DateTime       @default(now())
  short     Short          @relation(fields: [shortId], references: [id], onDelete: Cascade)
  user      User           @relation("ShortCommentUser", fields: [userId], references: [id], onDelete: Cascade)
  parent    ShortComment?  @relation("ShortCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ShortComment[] @relation("ShortCommentReplies")

  @@index([shortId])
  @@index([userId])
  @@index([parentId])
}

model PostShareEvent {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int?
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model PostComment {
  id        Int           @id @default(autoincrement())
  postId    Int
  userId    Int
  text      String
  // Instagram-style one-level nesting: replies point at the top-level
  // comment they belong to (never at another reply — the API flattens a
  // reply-to-a-reply onto the original parent before inserting).
  parentId  Int?
  createdAt DateTime      @default(now())
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation("PostCommentUser", fields: [userId], references: [id], onDelete: Cascade)
  parent    PostComment?  @relation("PostCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("PostCommentReplies")

  @@index([postId])
  @@index([userId])
  @@index([parentId])
}

model UserFollow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
}

model UserUnfollowEvent {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())
