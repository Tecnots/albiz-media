generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       Int                    @id
  name                     String
  handle                   String                 @unique
  email                    String                 @unique
  password                 String
  title                    String
  avatar                   String
  role                     UserRole               @default(NORMAL)
  verified                 Boolean                @default(false)
  isPremium                Boolean                @default(false)
  hasStory                 Boolean                @default(false)
  bio                      String?
  location                 String?
  country                  String?
  district                 String?
  city                     String?
  pincode                  String?
  website                  String?
  coverPhoto               String?
  joinedDate               String?
  followers                String                 @default("0")
  followingCount           String                 @default("0")
  customDomain             String?                @unique
  showBranding             Boolean                @default(true)
  banned                   Boolean                @default(false)
  banReason                String?
  canPost                  Boolean                @default(false)
  lastSeenAt               DateTime?
  publicKey                String?
  emailVerified            DateTime?
  verificationToken        String?
  verificationTokenExpiry  DateTime?
  resetPasswordToken       String?
  resetPasswordTokenExpiry DateTime?
  image                    String?
  deactivatedAt            DateTime?
  originalEmail            String?
  reactivationDate         DateTime?
  domainStatus             DomainStatus           @default(PENDING)
  domainToken              String?
  circleWelcomeSeen        Boolean                @default(false)
  notificationPrefs        Json?
  countryCode              String?
  countrySource            String?
  countryUpdatedAt         DateTime?
  gender                   String?
  birthYear                Int?
  createdAt                DateTime               @default(now())
  accounts                 Account[]
  adCampaigns              AdCampaign[]           @relation("AdCampaignCreator")
  sentSuggestions          AuthorSuggestion[]     @relation("AdminSuggestions")
  receivedSuggestions      AuthorSuggestion[]     @relation("AuthorSuggestions")
  circlePostLikes          CirclePostLike[]
  participantConversations Conversation[]         @relation("ParticipantConversations")
  otherUserConversations   Conversation[]         @relation("OtherUserConversations")
  notifications            Notification[]
  posts                    Post[]
  postEngagements          PostEngagement[]
  postImpressions          PostImpression[]
  sessions                 Session[]
  stories                  Story[]
  storyLikes               StoryLike[]
  storyViews               StoryView[]
  customTabs               UserCustomTab[]
  education                UserEducation[]
  experience               UserExperience[]
  followingRel             UserFollow[]           @relation("UserFollowers")
  followersRel             UserFollow[]           @relation("UserFollowing")
  highlights               UserHighlight[]
  interests                UserInterest[]
  mutedByUsers             UserMute[]             @relation("MutedUser")
  mutedUsers               UserMute[]             @relation("MuterUser")
  skills                   UserSkill[]
  circleUpgradeRequests    CircleUpgradeRequest[]
  editorAssignments        EditorSectionAssignment[] @relation("EditorAssignments")
  sentEditorNotes          EditorNote[]              @relation("EditorNotes")
  assignedPosts            Post[]                    @relation("AssignedEditorPosts")
  editorPreferences        EditorPreferences?        @relation("EditorPreferences")
  editorTemplates          EditorNoteTemplate[]      @relation("EditorTemplates")
  editorActivity           EditorActivity[]          @relation("EditorActivity")
  pushTokens               PushToken[]
  verificationRequests     VerificationRequest[]
  contentReports           ContentReport[]       @relation("ReportedBy")
  resolvedReports          ContentReport[]       @relation("ResolvedBy")
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id              Int              @id
  userId          Int
  type            PostType
  content         String?
  title           String?
  description     String?
  date            String
  time            String?
  image           String?
  tags            String[]
  views           String           @default("0")
  likes           String           @default("0")
  comments        String           @default("0")
  shares          String           @default("0")
  status          String           @default("published")
  featured        Boolean          @default(false)
  pinned          Boolean          @default(false)
  flagged         Boolean          @default(false)
  flagReason      String?
  slug            String?          @unique
  seoDescription  String?
  sectionId       Int?
  language        String           @default("en")
  createdAt       DateTime         @default(now())
  contentScope    String           @default("GLOBAL")
  countryCode     String?
  assignedEditorId Int?
  publishAt        DateTime?
  scheduleJobId    String?
  articleContent   ArticleContent?
  section          ArticleSection?  @relation(fields: [sectionId], references: [id])
  user             User             @relation(fields: [userId], references: [id])
  assignedEditor   User?            @relation("AssignedEditorPosts", fields: [assignedEditorId], references: [id])
  postComments     PostComment[]
  engagements      PostEngagement[]
  impressions      PostImpression[]
  postLikes        PostLike[]
  postShareEvents  PostShareEvent[]
  savedPosts       SavedPost[]
  editorNotes      EditorNote[]
  editorActivity   EditorActivity[] @relation("PostEditorActivity")
  contentReports   ContentReport[]
}

model VisitorLog {
  id          Int      @id @default(autoincrement())
  country     String?
  countryCode String?
  city        String?
  lat         Float?
  lon         Float?
  page        String?
  device      String?
  referrer    String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model ArticleSection {
  id               Int             @id @default(autoincrement())
  name             String
  slug             String          @unique
  description      String?
  color            String          @default("#525252")
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  workflowPresetId Int?
  workflowPreset    WorkflowPreset?          @relation(fields: [workflowPresetId], references: [id])
  posts             Post[]
  editorAssignments EditorSectionAssignment[]
}

model WorkflowPreset {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  stages      String[]
  createdAt   DateTime         @default(now())
  sections    ArticleSection[]
}

model ArticleContent {
  id         Int      @id @default(autoincrement())
  postId     Int      @unique
  paragraphs String[]
  post       Post     @relation(fields: [postId], references: [id])
}

model CircleMember {
  id         Int          @id
  name       String
  title      String
  avatar     String       @default("")
  hasInitial Boolean      @default(false)
  initial    String?
  initialBg  String?
  verified   Boolean      @default(true)
  rank       Int
  posts      CirclePost[]
}

model CirclePost {
  id        Int              @id @default(autoincrement())
  memberId  Int
  content   String
  image     String?
  likes     String           @default("0")
  comments  String           @default("0")
  createdAt DateTime         @default(now())
  member    CircleMember     @relation(fields: [memberId], references: [id])
  postLikes CirclePostLike[]

  @@index([createdAt])
  @@index([memberId])
}

model CirclePostLike {
  id        Int        @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime   @default(now())
  post      CirclePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model PushToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id          Int               @id @default(autoincrement())
  type        NotificationType
  userId      Int
  recipientId Int               @default(1)
  time        String
  group       NotificationGroup
  unread      Boolean           @default(false)
  postPreview String?
  postImage   String?
  postId      Int?
  message     String?
  user        User              @relation(fields: [userId], references: [id])

  @@unique([type, userId, recipientId, postId])
}

model Conversation {
  id                Int       @id
  userId            Int
  lastMessage       String
  time              String
  unreadCount       Int       @default(0)
  online            Boolean   @default(false)
  updatedAt         DateTime  @default(now()) @updatedAt
  typingUserId      Int?
  typingAt          DateTime?
  encryptionEnabled Boolean   @default(false)
  participantId     Int?
  participant       User?     @relation("ParticipantConversations", fields: [participantId], references: [id])
  user              User      @relation("OtherUserConversations", fields: [userId], references: [id])
  messages          Message[]
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  fromMe         Boolean
  text           String
  time           String
  senderId       Int          @default(1)
  status         String       @default("sent")
  encrypted      Boolean      @default(false)
  iv             String?
  createdAt      DateTime     @default(now())
  attachmentName String?
  attachmentSize Int?
  attachmentType String?
  attachmentUrl  String?
  deleted        Boolean      @default(false)
  edited         Boolean      @default(false)
  editedAt       DateTime?
  savedByUser    Int?
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model Story {
  id          Int         @id @default(autoincrement())
  userId      Int
  imageUrl    String
  textOverlay String?
  textColor   String?
  textPosX    Float       @default(50)
  textPosY    Float       @default(50)
  textScale   Float       @default(1)
  location    String?
  locPosX     Float       @default(50)
  locPosY     Float       @default(20)
  imgPosX     Float       @default(0)
  imgPosY     Float       @default(0)
  imgScale    Float       @default(1)
  imgFit      String      @default("contain")
  textBold    Boolean     @default(false)
  textItalic  Boolean     @default(false)
  textAlign   String      @default("center")
  stickers    Json?
  visibility  String      @default("public")
  status      String      @default("published")
  views       Int         @default(0)
  likes       Int         @default(0)
  createdAt   DateTime    @default(now())
  expiresAt   DateTime
  shares      Int         @default(0)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyLikes  StoryLike[]
  storyViews  StoryView[]
}

model StoryView {
  id       Int      @id @default(autoincrement())
  storyId  Int
  userId   Int
  viewedAt DateTime @default(now())
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

model StoryLike {
  id      Int      @id @default(autoincrement())
  storyId Int
  userId  Int
  likedAt DateTime @default(now())
  story   Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

model TrendingTopic {
  id    Int    @id
  name  String
  posts String
  image String
}

model SavedCollection {
  id    Int    @id
  name  String
  count Int
  image String
}

model SavedPost {
  id           Int  @id @default(autoincrement())
  userId       Int  @default(1)
  postId       Int
  collectionId Int?
  post         Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

model UserCollection {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  image     String   @default("")
  createdAt DateTime @default(now())
}

model ContentTopic {
  id       String  @id
  label    String
  selected Boolean @default(false)
}

model AnalyticsStat {
  id        Int     @id @default(autoincrement())
  label     String
  value     String
  change    Float
  up        Boolean
  sparkline Float[]
}

model ViewOverTime {
  id    Int    @id @default(autoincrement())
  date  String
  value Int
}

model TopPost {
  id    Int    @id
  title String
  views String
  likes String
  image String
}

model QuickSnapshot {
  id    Int    @id @default(autoincrement())
  label String
  value String
}

model AccountSetting {
  id    Int    @id @default(autoincrement())
  label String
  value String
}

model LanguageRegionSetting {
  id    Int    @id @default(autoincrement())
  label String
  value String
}

model UserExperience {
  id          Int    @id @default(autoincrement())
  userId      Int
  role        String
  company     String
  logo        String @default("")
  period      String
  description String @default("")
  order       Int    @default(0)
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserEducation {
  id     Int    @id @default(autoincrement())
  userId Int
  school String
  degree String
  period String
  logo   String @default("")
  order  Int    @default(0)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSkill {
  id     Int    @id @default(autoincrement())
  userId Int
  name   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model UserInterest {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model UserCustomTab {
  id      Int    @id @default(autoincrement())
  userId  Int
  title   String
  content String @default("")
  order   Int    @default(0)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserHighlight {
  id         Int      @id @default(autoincrement())
  userId     Int
  name       String
  cover      String   @default("")
  images     String[]
  storyCount Int      @default(0)
  order      Int      @default(0)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PostLike {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model PostShareEvent {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int?
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model PostComment {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  text      String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model UserFollow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model UserUnfollowEvent {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  @@index([followingId, createdAt])
}

model BlockedUser {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model UserInvite {
  id          Int      @id @default(autoincrement())
  email       String
  role        UserRole
  token       String   @unique
  status      String   @default("pending")
  invitedById Int
  name        String?
  note        String?
  metadata    Json?
  createdAt   DateTime @default(now())
  expiresAt   DateTime
}

model EditorSectionAssignment {
  id         Int            @id @default(autoincrement())
  editorId   Int
  sectionId  Int
  canPublish Boolean        @default(false)
  createdAt  DateTime       @default(now())
  editor     User           @relation("EditorAssignments", fields: [editorId], references: [id], onDelete: Cascade)
  section    ArticleSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([editorId, sectionId])
  @@index([sectionId])
}

model EditorNote {
  id         Int       @id @default(autoincrement())
  postId     Int
  editorId   Int
  note       String
  type       String    @default("general")
  priority   String    @default("minor")
  resolvedAt DateTime?
  resolvedBy Int?
  createdAt  DateTime  @default(now())
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  editor     User      @relation("EditorNotes", fields: [editorId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model EditorPreferences {
  editorId            Int     @id
  defaultNoteType     String  @default("general")
  defaultNotePriority String  @default("minor")
  notifyOnSubmit      Boolean @default(true)
  notifyOnResolve     Boolean @default(true)
  editor              User    @relation("EditorPreferences", fields: [editorId], references: [id], onDelete: Cascade)
}

model EditorNoteTemplate {
  id        Int      @id @default(autoincrement())
  editorId  Int
  text      String
  createdAt DateTime @default(now())
  editor    User     @relation("EditorTemplates", fields: [editorId], references: [id], onDelete: Cascade)

  @@index([editorId])
}

model EditorActivity {
  id        Int      @id @default(autoincrement())
  editorId  Int
  postId    Int
  action    String
  createdAt DateTime @default(now())
  editor    User     @relation("EditorActivity", fields: [editorId], references: [id], onDelete: Cascade)
  post      Post     @relation("PostEditorActivity", fields: [postId], references: [id], onDelete: Cascade)

  @@index([editorId, createdAt])
}

model SocialConnection {
  id                Int             @id @default(autoincrement())
  userId            Int
  platform          String
  platformUserId    String
  platformHandle    String?
  platformAvatarUrl String?
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime?
  webhookSecret     String?
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  messages          SocialMessage[]
  threads           SocialThread[]

  @@unique([userId, platform])
}

model SocialThread {
  id                Int              @id @default(autoincrement())
  connectionId      Int
  platform          String?
  externalUserId    String
  externalHandle    String?
  externalAvatarUrl String?
  lastMessageAt     DateTime         @default(now())
  unreadCount       Int              @default(0)
  messages          SocialMessage[]
  connection        SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalUserId])
}

model SocialMessage {
  id            Int              @id @default(autoincrement())
  connectionId  Int
  externalId    String
  fromHandle    String?
  fromAvatarUrl String?
  text          String
  attachmentUrl String?
  read          Boolean          @default(false)
  createdAt     DateTime         @default(now())
  direction     String           @default("inbound")
  threadId      Int?
  connection    SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  thread        SocialThread?    @relation(fields: [threadId], references: [id])

  @@unique([connectionId, externalId])
}

model CircleUpgradeRequest {
  id                Int                         @id @default(autoincrement())
  userId            Int
  accountType       CircleAccountType
  documentType      CircleDocumentType?
  documentNumber    String?
  documentUrl       String?
  status            CircleUpgradeStatus         @default(PENDING)
  fullName          String
  professionalTitle String
  company           String?
  location          String
  city              String?
  district          String?
  country           String?
  pincode           String?
  website           String?
  linkedin          String?
  bio               String?
  reason            String
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  documents         CircleUpgradeDocument[]
  registrations     CircleUpgradeRegistration[]
  user              User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("circle_upgrade_requests")
}

model CircleUpgradeRegistration {
  id                 Int                     @id @default(autoincrement())
  requestId          Int
  registrationType   CircleDocumentType
  registrationNumber String
  createdAt          DateTime                @default(now())
  documents          CircleUpgradeDocument[]
  request            CircleUpgradeRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("circle_upgrade_registrations")
}

model CircleUpgradeDocument {
  id             Int                        @id @default(autoincrement())
  requestId      Int
  registrationId Int?
  documentUrl    String
  documentType   CircleDocumentType
  createdAt      DateTime                   @default(now())
  registration   CircleUpgradeRegistration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  request        CircleUpgradeRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("circle_upgrade_documents")
}

model ActivityLog {
  id        Int               @id @default(autoincrement())
  eventType ActivityEventType
  userId    Int?
  userName  String?
  handle    String?
  avatar    String?
  meta      String?
  createdAt DateTime          @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([eventType])
  @@index([userId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
}

model AdminSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AdminNotification {
  id        Int                   @id @default(autoincrement())
  type      AdminNotificationType
  title     String
  message   String
  metadata  Json?
  unread    Boolean               @default(true)
  createdAt DateTime              @default(now())
}

model BlobInfo {
  id          Int       @id @default(autoincrement())
  guid        String    @unique @default(uuid())
  blobName    String    @db.VarChar(500)
  container   String    @db.VarChar(200)
  filename    String    @db.VarChar(255)
  contentType String    @db.VarChar(100)
  size        BigInt
  source      String    @db.VarChar(100)
  description String?
  uploadedBy  Int?
  metadata    Json?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([blobName])
  @@index([source])
  @@index([uploadedBy])
}

model AuthorSuggestion {
  id          Int      @id @default(autoincrement())
  authorId    Int
  adminId     Int
  title       String
  description String?
  deadline    String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  admin       User     @relation("AdminSuggestions", fields: [adminId], references: [id], onDelete: Cascade)
  author      User     @relation("AuthorSuggestions", fields: [authorId], references: [id], onDelete: Cascade)
}

model PostImpression {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  seenAt    DateTime @default(now())
  position  Int?
  sessionId String?
  device    String?
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, seenAt])
  @@index([postId])
}

model UserMute {
  id        Int      @id @default(autoincrement())
  userId    Int
  mutedId   Int
  createdAt DateTime @default(now())
  muted     User     @relation("MutedUser", fields: [mutedId], references: [id], onDelete: Cascade)
  user      User     @relation("MuterUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mutedId])
  @@index([userId])
}

model PostEngagement {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  action    String
  createdAt DateTime @default(now())
  value     Float    @default(1.0)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, action])
  @@index([postId])
  @@index([userId, postId])
  @@index([createdAt])
}

model AdCampaign {
  id              Int          @id @default(autoincrement())
  name            String
  advertiserName  String
  advertiserEmail String?
  status          AdStatus     @default(DRAFT)
  budget          Decimal      @default(0) @db.Decimal(12, 2)
  spent           Decimal      @default(0) @db.Decimal(12, 2)
  cpc             Decimal      @default(0) @db.Decimal(8, 2)
  promoteType     String       @default("custom")
  promoteTargetId Int?
  placements      String[]
  targetCountries String[]     @default([]) // ISO alpha-2; empty = all countries
  targetTags      String[]     @default([]) // interest tags; empty = untargeted
  targetAudience  String       @default("all") // all | guests | members | followers
  pacing          String       @default("even") // even | accelerated
  dailyBudget     Decimal?     @db.Decimal(12, 2) // spend ceiling per day for even pacing
  frequencyCap    Int          @default(0) // max impressions per user per day; 0 = unlimited
  priority        Int          @default(0) // manual admin score boost
  startDate       DateTime
  endDate         DateTime
  createdById     Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  createdBy       User?        @relation("AdCampaignCreator", fields: [createdById], references: [id])
  creatives       AdCreative[]
  events          AdEvent[]
  placementZones  AdCampaignPlacement[]

  @@index([status])
  @@index([startDate, endDate])
}

model AdCreative {
  id          Int        @id @default(autoincrement())
  campaignId  Int
  imageUrl    String?
  headline    String
  description String?
  ctaText     String     @default("Learn More")
  ctaUrl      String?
  sponsorName String
  sponsorLogo String?
  weight      Int        @default(1) // A/B rotation weight
  impressions Int        @default(0) // denormalized for fast CTR-based rotation
  clicks      Int        @default(0)
  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model AdEvent {
  id         Int         @id @default(autoincrement())
  campaignId Int
  creativeId Int? // which creative variant served â€” A/B attribution
  type       AdEventType
  placement  String
  userId     Int?
  anonId     String? // session cookie id for guest frequency capping
  createdAt  DateTime    @default(now())
  campaign   AdCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, type])
  @@index([createdAt])
  @@index([userId, campaignId, createdAt])
  @@index([anonId, campaignId, createdAt])
}

model AdPlacementZone {
  id          Int                   @id @default(autoincrement())
  name        String
  key         String                @unique
  description String?
  isActive    Boolean               @default(true)
  sortOrder   Int                   @default(0)
  zone        String                @default("body") // header | sidebar | body | footer | overlay
  positionX   Float                 @default(0.5)
  positionY   Float                 @default(0.5)
  width       Int?
  height      Int?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  campaigns   AdCampaignPlacement[]

  @@index([isActive])
  @@index([sortOrder])
}

model AdCampaignPlacement {
  id         Int             @id @default(autoincrement())
  campaignId Int
  zoneId     Int
  sortOrder  Int             @default(0)
  campaign   AdCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  zone       AdPlacementZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([campaignId, zoneId])
  @@index([campaignId])
  @@index([zoneId])
}

model Job {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  status      String    @default("pending")
  priority    Int       @default(0)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?
  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
  @@index([type, status])
  @@index([createdAt])
}

model EmailLog {
  id          String    @id @default(uuid())
  to          String
  subject     String
  templateKey String
  jobId       String?
  status      String    @default("queued")
  error       String?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([to])
  @@index([status])
  @@index([createdAt])
}

model ActivityLogArchive {
  id         Int               @id
  eventType  ActivityEventType
  userId     Int?
  userName   String?
  handle     String?
  avatar     String?
  meta       String?
  createdAt  DateTime
  archivedAt DateTime          @default(now())

  @@index([createdAt])
}

enum ActivityEventType {
  SIGNUP
  SIGNIN
  DEACTIVATE
  REACTIVATE
  DELETE_ACCOUNT
  CIRCLE_REQUEST
  CIRCLE_APPROVED
  CIRCLE_REJECTED
  BAN
  UNBAN
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  CONTENT_REPORTED
  CONTENT_MODERATED
  ARTICLE_SCHEDULED
  ARTICLE_UNSCHEDULED
  ARTICLE_PUBLISHED
  ARTICLE_PUBLISH_FAILED
}

enum DomainStatus {
  PENDING
  ACTIVE
  FAILED
}

enum UserRole {
  NORMAL
  CIRCLE
  ADMIN
  AUTHOR
  EDITOR
}

enum PostType {
  POST
  ARTICLE
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  MENTION
  LIKE_STORY
  CIRCLE_WELCOME
  CIRCLE_PENDING
  CIRCLE_REJECTED
  POST_REMOVED
  NEW_POST
  NEW_STORY
  MESSAGE
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  ARTICLE_PUBLISHED
}

enum NotificationGroup {
  TODAY
  YESTERDAY
  EARLIER
}

enum CircleUpgradeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdminNotificationType {
  NEW_USER
  CIRCLE_UPGRADE
  CONTENT_REPORT
  AUTHOR_REQUEST
  SYSTEM
}

enum CircleAccountType {
  INDIVIDUAL
  COMPANY
}

enum CircleDocumentType {
  AADHAAR
  PAN
  PASSPORT
  DRIVING_LICENSE
  GST
  CERTIFICATE_OF_INCORPORATION
  COMPANY_PAN
  MSME
}

enum AdStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
}

enum AdEventType {
  IMPRESSION
  CLICK
}

enum VerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContentReportStatus {
  PENDING
  DISMISSED
  ACTION_TAKEN
}

model VerificationRequest {
  id         Int                       @id @default(autoincrement())
  userId     Int
  reason     String?
  status     VerificationRequestStatus @default(PENDING)
  reviewedBy Int?
  reviewNote String?
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  user       User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("verification_requests")
}

model ContentReport {
  id          Int                 @id @default(autoincrement())
  postId      Int
  reporterId  Int
  reason      String
  description String?
  status      ContentReportStatus @default(PENDING)
  resolvedBy  Int?
  resolvedAt  DateTime?
  resolution  String?
  createdAt   DateTime            @default(now())
  post        Post                @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter    User                @relation("ReportedBy", fields: [reporterId], references: [id])
  resolver    User?               @relation("ResolvedBy", fields: [resolvedBy], references: [id])

  @@unique([postId, reporterId])
  @@index([postId])
  @@index([status])
  @@map("content_reports")
}
