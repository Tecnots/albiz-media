  format          String            @default("vertical")
  status          String            @default("draft")
  userId          Int
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  rejectionNote   String?
  views           Int               @default(0)
  likes           Int               @default(0)
  shares          Int               @default(0)
  comments        Int               @default(0)
  // Interest and geo signals — used by the recommendation engine
  tags            String[]          @default([])
  countryCode     String?
  contentScope    String            @default("GLOBAL")
  // Moderation
  flagged         Boolean           @default(false)
  flagReason      String?
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  watchEvents     ShortWatchEvent[]
  activity        ShortActivity[]
  likedBy         ShortLike[]
  savedBy         SavedShort[]
  shortComments   ShortComment[]
  // Reviewer assignment + scheduling — previously Shorts had neither
  // (audit findings M-13 / L-8). assignedAdminId is advisory (any ADMIN can
  // still approve/reject/publish any Short — Shorts moderators are a flat,
  // equally-trusted pool unlike Articles' section-scoped editors) and exists
  // for queue triage and accountability, not as a hard access gate.
  assignedAdminId Int?
  assignedAdmin   User?             @relation("AssignedAdminShorts", fields: [assignedAdminId], references: [id])
  scheduleJobId   String?

  @@index([userId])
  @@index([status])
  @@index([status, flagged])
  @@index([countryCode])
  @@index([publishedAt])
  @@index([userId, publishedAt])
  @@index([assignedAdminId])
}

/**
 * Audit trail for Shorts moderation actions (submit/approve/reject/publish/
 * unpublish) — mirrors EditorActivity for Post/Article. Previously no such
 * table existed at all: Shorts moderation left no historical record of who
 * approved/rejected/published anything (audit finding H-4).
 */
model ShortActivity {
  id        Int      @id @default(autoincrement())
  editorId  Int
  shortId   Int
  action    String
  createdAt DateTime @default(now())
  editor    User     @relation("ShortActivity", fields: [editorId], references: [id], onDelete: Cascade)
  short     Short    @relation(fields: [shortId], references: [id], onDelete: Cascade)

  @@index([shortId])
  @@index([editorId])
}

// Tracks every significant viewer interaction with a Short.
// Phase 1: action = "view" | "like" | "share" | "comment" | "skip" | "follow_after"
// Phase 2: watchedMs, durationMs, watchPct, completed, loopCount, fastSkip are used
//          by the ranking engine once sufficient data accumulates.
model ShortWatchEvent {
  id         Int      @id @default(autoincrement())
  shortId    Int
  userId     Int?
  sessionId  String?
  // Video-behavior signals (Phase 2 — populated by client during playback)
  watchedMs  Int      @default(0)
  durationMs Int      @default(0)
  watchPct   Float    @default(0)
  completed  Boolean  @default(false)
  loopCount  Int      @default(0)
  fastSkip   Boolean  @default(false)
  // Action label: "view" | "like" | "share" | "comment" | "skip" | "complete" | "follow_after" | "not_interested"
  action     String   @default("view")
  createdAt  DateTime @default(now())
  short      Short    @relation(fields: [shortId], references: [id], onDelete: Cascade)

  @@index([shortId])
  @@index([userId, createdAt])
  @@index([shortId, createdAt])
  @@index([userId, shortId])
}

model UserDeviceSession {
  id           Int      @id @default(autoincrement())
  userId       Int
  deviceName   String?
  userAgent    String?
  ip           String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  isActive     Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("user_device_sessions")
}

model StripeCustomer {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  stripeCustomerId String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions StripeSubscription[]
  invoices      StripeInvoice[]

  @@index([stripeCustomerId])
  @@map("stripe_customers")
}

model StripeSubscription {
  id                   Int       @id @default(autoincrement())
  userId               Int
  stripeSubscriptionId String    @unique
  stripePriceId        String
  product              String
  status               String
  interval             String
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)
  canceledAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer StripeCustomer  @relation(fields: [userId], references: [userId], map: "stripe_subscriptions_customer_fkey")
  invoices StripeInvoice[]

  @@index([userId])
  @@index([status])
  @@map("stripe_subscriptions")
}

model StripeInvoice {
  id              Int       @id @default(autoincrement())
  userId          Int
  stripeInvoiceId String    @unique
  subscriptionId  String?
  status          String
  amountPaid      Int
  currency        String    @default("usd")
  invoiceUrl      String?
  invoicePdf      String?
  periodStart     DateTime?
  periodEnd       DateTime?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer     StripeCustomer      @relation(fields: [userId], references: [userId], map: "stripe_invoices_customer_fkey")
  subscription StripeSubscription? @relation(fields: [subscriptionId], references: [stripeSubscriptionId])

  @@index([userId])
  @@map("stripe_invoices")
}

model StripeWebhookEvent {
  id            Int      @id @default(autoincrement())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())

  @@map("stripe_webhook_events")
}

model TrendingTopicScore {
  id              Int      @id @default(autoincrement())
  tag             String
  scope           String   @default("GLOBAL")
  score           Float
  velocity        Float
  freshness       Float
  participation   Float
  popularity      Float
  geo             Float
  postCount       Int
  authorCount     Int
  engagementTotal Int
  computedAt      DateTime @default(now())

  @@unique([tag, scope])
  @@index([scope, score])
  @@index([computedAt])
  @@map("trending_topic_scores")
}
