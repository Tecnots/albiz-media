generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Core Domain Models ───

enum UserRole {
  NORMAL
  CIRCLE
  ADMIN
  AUTHOR
}

model User {
  id             Int            @id
  name           String
  handle         String         @unique
  email          String         @unique
  password       String
  title          String
  avatar         String
  role           UserRole       @default(NORMAL)
  verified       Boolean        @default(false)
  isPremium      Boolean        @default(false)
  hasStory       Boolean        @default(false)
  bio            String?
  location       String?
  website        String?
  coverPhoto     String?
  joinedDate     String?
  followers      String         @default("0")
  followingCount String         @default("0")
  posts          Post[]
  notifications  Notification[]
  conversations  Conversation[]
  experience     UserExperience[]
  education      UserEducation[]
  skills         UserSkill[]
  interests      UserInterest[]
  customTabs     UserCustomTab[]
  highlights     UserHighlight[]
  customDomain   String?          @unique
  domainVerified Boolean          @default(false)
  showBranding   Boolean          @default(true)
  banned         Boolean          @default(false)
  followersRel   UserFollow[]     @relation("UserFollowing")
  followingRel   UserFollow[]     @relation("UserFollowers")
  // Chat & presence
  lastSeenAt     DateTime?
  publicKey      String?
  stories        Story[]
  // Email auth
  emailVerified            Boolean   @default(true)
  verificationToken        String?
  verificationTokenExpiry  DateTime?
  resetPasswordToken       String?
  resetPasswordTokenExpiry DateTime?
}

enum PostType {
  POST
  ARTICLE
}

model Post {
  id             Int              @id
  userId         Int
  user           User             @relation(fields: [userId], references: [id])
  type           PostType
  content        String?
  title          String?
  description    String?
  date           String
  time           String?
  image          String?
  tags           String[]
  views          String           @default("0")
  likes          String           @default("0")
  comments       String           @default("0")
  shares         String           @default("0")
  status         String           @default("published")
  featured       Boolean          @default(false)
  pinned         Boolean          @default(false)
  articleContent ArticleContent?
  savedPosts     SavedPost[]
  postComments   PostComment[]
  postLikes      PostLike[]
}

model ArticleContent {
  id         Int      @id @default(autoincrement())
  postId     Int      @unique
  post       Post     @relation(fields: [postId], references: [id])
  paragraphs String[]
}

model CircleMember {
  id         Int          @id
  name       String
  title      String
  avatar     String       @default("")
  hasInitial Boolean      @default(false)
  initial    String?
  initialBg  String?
  verified   Boolean      @default(true)
  rank       Int
  posts      CirclePost[]
}

model CirclePost {
  id       Int          @id @default(autoincrement())
  memberId Int
  member   CircleMember @relation(fields: [memberId], references: [id])
  content  String
  image    String?
  likes    String       @default("0")
  comments String       @default("0")
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  MENTION
  LIKE_STORY
}

enum NotificationGroup {
  TODAY
  YESTERDAY
  EARLIER
}

model Notification {
  id          Int               @id
  type        NotificationType
  userId      Int
  user        User              @relation(fields: [userId], references: [id])
  recipientId Int               @default(1)
  time        String
  group       NotificationGroup
  unread      Boolean           @default(false)
  postPreview String?
  postImage   String?
}

model Conversation {
  id                Int       @id
  userId            Int
  user              User      @relation(fields: [userId], references: [id])
  lastMessage       String
  time              String
  unreadCount       Int       @default(0)
  online            Boolean   @default(false)
  messages          Message[]
  // Chat features
  updatedAt         DateTime  @default(now()) @updatedAt
  typingUserId      Int?
  typingAt          DateTime?
  encryptionEnabled Boolean   @default(true)
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  fromMe         Boolean
  text           String
  time           String
  // Chat features
  senderId       Int          @default(1)
  status         String       @default("sent")
  encrypted      Boolean      @default(false)
  iv             String?
  createdAt      DateTime     @default(now())
}

// ─── Stories ───

model Story {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageUrl    String    // Azure blob URL
  textOverlay String?   // optional text on the story
  textColor   String?   // hex color for overlay text
  textPosX    Float     @default(50)  // text x position (%)
  textPosY    Float     @default(50)  // text y position (%)
  textScale   Float     @default(1)
  location    String?   // location tag
  locPosX     Float     @default(50)  // location x position (%)
  locPosY     Float     @default(20)  // location y position (%)
  imgPosX     Float     @default(0)
  imgPosY     Float     @default(0)
  imgScale    Float     @default(1)
  imgFit      String    @default("contain") // "contain" | "cover"
  visibility  String    @default("public") // "public" | "circle"
  status      String    @default("published") // "published" | "draft" | "archived"
  views       Int       @default(0)
  likes       Int       @default(0)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime  // 24 hours after creation
}

// ─── Discovery & Content ───

model TrendingTopic {
  id    Int    @id
  name  String
  posts String
  image String
}

model SavedCollection {
  id    Int    @id
  name  String
  count Int
  image String
}

model SavedPost {
  id           Int  @id @default(autoincrement())
  userId       Int  @default(1)
  postId       Int
  collectionId Int?
  post         Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

model UserCollection {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  image     String   @default("")
  createdAt DateTime @default(now())
}

model ContentTopic {
  id       String  @id
  label    String
  selected Boolean @default(false)
}

// ─── Analytics & Config ───

model AnalyticsStat {
  id        Int     @id @default(autoincrement())
  label     String
  value     String
  change    Float
  up        Boolean
  sparkline Float[]
}

model ViewOverTime {
  id    Int    @id @default(autoincrement())
  date  String
  value Int
}

model TopPost {
  id    Int    @id
  title String
  views String
  likes String
  image String
}

model QuickSnapshot {
  id    Int    @id @default(autoincrement())
  label String
  value String
}

model AccountSetting {
  id    Int    @id @default(autoincrement())
  label String
  value String
}

model LanguageRegionSetting {
  id    Int    @id @default(autoincrement())
  label String
  value String
}

// ─── Profile Models ───

model UserExperience {
  id          Int    @id @default(autoincrement())
  userId      Int
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String
  company     String
  logo        String @default("")
  period      String
  description String @default("")
  order       Int    @default(0)
}

model UserEducation {
  id     Int    @id @default(autoincrement())
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school String
  degree String
  period String
  logo   String @default("")
  order  Int    @default(0)
}

model UserSkill {
  id     Int    @id @default(autoincrement())
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String

  @@unique([userId, name])
}

model UserInterest {
  id     Int    @id @default(autoincrement())
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String

  @@unique([userId, name])
}

model UserCustomTab {
  id      Int    @id @default(autoincrement())
  userId  Int
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title   String
  content String @default("")
  order   Int    @default(0)
}

model UserHighlight {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  cover      String   @default("")
  images     String[]
  storyCount Int      @default(0)
  order      Int      @default(0)
}

model PostLike {
  id     Int @id @default(autoincrement())
  postId Int
  userId Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model PostComment {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  text      String
  createdAt DateTime @default(now())
}

model UserFollow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model BlockedUser {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}
