model SocialConnection {
  id                Int             @id @default(autoincrement())
  userId            Int
  platform          String
  platformUserId    String
  platformHandle    String?
  platformAvatarUrl String?
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime?
  webhookSecret     String?
  active            Boolean         @default(true)
  // Connection health, surfaced in Settings' Connected Accounts UI: set on
  // every successful inbound sync (webhook message saved, or a Twitter poll
  // completes) and every successful token refresh; lastSyncError is cleared
  // on success and set to a user-friendly message on failure so a broken
  // connection has an honest, specific reason instead of a bare status pill.
  lastSyncedAt      DateTime?
  lastSyncError     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages          SocialMessage[]
  threads           SocialThread[]

  @@unique([userId, platform])
}

