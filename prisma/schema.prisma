generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       Int                    @id
  name                     String
  handle                   String                 @unique
  email                    String                 @unique
  password                 String
  title                    String
  avatar                   String
  role                     UserRole               @default(NORMAL)
  verified                 Boolean                @default(false)
  isPremium                Boolean                @default(false)
  hasStory                 Boolean                @default(false)
  bio                      String?
  location                 String?
  website                  String?
  coverPhoto               String?
  joinedDate               String?
  followers                String                 @default("0")
  followingCount           String                 @default("0")
  customDomain             String?                @unique
  showBranding             Boolean                @default(true)
  banned                   Boolean                @default(false)
  banReason                String?
  canPost                  Boolean                @default(false)
  circleWelcomeSeen        Boolean                @default(false)
  lastSeenAt               DateTime?
  publicKey                String?
  emailVerified            DateTime?
  verificationToken        String?
  verificationTokenExpiry  DateTime?
  resetPasswordToken       String?
  resetPasswordTokenExpiry DateTime?
  image                    String?
  deactivatedAt            DateTime?
  originalEmail            String?
  reactivationDate         DateTime?
  domainStatus             DomainStatus           @default(PENDING)
  domainToken              String?
  accounts                 Account[]
  participantConversations Conversation[]         @relation("ParticipantConversations")
  otherUserConversations   Conversation[]         @relation("OtherUserConversations")
  notifications            Notification[]
  posts                    Post[]
  sessions                 Session[]
  stories                  Story[]
  storyLikes               StoryLike[]
  storyViews               StoryView[]
  customTabs               UserCustomTab[]
  education                UserEducation[]
  experience               UserExperience[]
  followingRel             UserFollow[]           @relation("UserFollowers")
  followersRel             UserFollow[]           @relation("UserFollowing")
  highlights               UserHighlight[]
  interests                UserInterest[]
  skills                   UserSkill[]
  circleUpgradeRequests    CircleUpgradeRequest[]
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id             Int             @id
  userId         Int
  type           PostType
  content        String?
  title          String?
  description    String?
  date           String
  time           String?
  image          String?
  tags           String[]
  views          String          @default("0")
  likes          String          @default("0")
  comments       String          @default("0")
  shares         String          @default("0")
  status         String          @default("published")
  featured       Boolean         @default(false)
  pinned         Boolean         @default(false)
  slug           String?         @unique
  seoDescription String?
  sectionId      Int?
  language       String          @default("en")
  articleContent ArticleContent?
  section        ArticleSection? @relation(fields: [sectionId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  postComments   PostComment[]
  postLikes      PostLike[]
  savedPosts     SavedPost[]
}

model VisitorLog {
  id          Int      @id @default(autoincrement())
  country     String?
  countryCode String?
  city        String?
  lat         Float?
  lon         Float?
  page        String?
  device      String?
  referrer    String?
  createdAt   DateTime @default(now())
}

model ArticleSection {
  id               Int             @id @default(autoincrement())
  name             String
  slug             String          @unique
  description      String?
  color            String          @default("#525252")
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  workflowPresetId Int?
  workflowPreset   WorkflowPreset? @relation(fields: [workflowPresetId], references: [id])
  posts            Post[]
}

model WorkflowPreset {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  stages      String[]
  createdAt   DateTime         @default(now())
  sections    ArticleSection[]
}

model ArticleContent {
  id         Int      @id @default(autoincrement())
  postId     Int      @unique
  paragraphs String[]
  post       Post     @relation(fields: [postId], references: [id])
}

model CircleMember {
  id         Int          @id
  name       String
  title      String
  avatar     String       @default("")
  hasInitial Boolean      @default(false)
  initial    String?
  initialBg  String?
  verified   Boolean      @default(true)
  rank       Int
  posts      CirclePost[]
}

model CirclePost {
  id       Int          @id @default(autoincrement())
  memberId Int
  content  String
  image    String?
  likes    String       @default("0")
  comments String       @default("0")
  member   CircleMember @relation(fields: [memberId], references: [id])
}

model Notification {
  id          Int               @id @default(autoincrement())
  type        NotificationType
  userId      Int
  recipientId Int               @default(1)
  time        String
  group       NotificationGroup
  unread      Boolean           @default(false)
  postPreview String?
  postImage   String?
  postId      Int?
  user        User              @relation(fields: [userId], references: [id])

  @@unique([type, userId, recipientId, postId])
}

model Conversation {
  id                Int       @id
  updatedAt         DateTime  @default(now()) @updatedAt
  encryptionEnabled Boolean   @default(false)
  lastMessage       String
  online            Boolean   @default(false)
  participantId     Int?
  time              String
  typingAt          DateTime?
  typingUserId      Int?
  unreadCount       Int       @default(0)
  userId            Int
  participant       User?     @relation("ParticipantConversations", fields: [participantId], references: [id])
  user              User      @relation("OtherUserConversations", fields: [userId], references: [id])
  messages          Message[]
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  text           String
  senderId       Int          @default(1)
  status         String       @default("sent")
  encrypted      Boolean      @default(false)
  iv             String?
  createdAt      DateTime     @default(now())
  fromMe         Boolean
  time           String
  attachmentName String?
  attachmentSize Int?
  attachmentType String?
  attachmentUrl  String?
  deleted        Boolean      @default(false)
  edited         Boolean      @default(false)
  editedAt       DateTime?
  savedByUser    Int?
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model Story {
  id          Int         @id @default(autoincrement())
  userId      Int
  imageUrl    String
  textOverlay String?
  textColor   String?
  textPosX    Float       @default(50)
  textPosY    Float       @default(50)
  textScale   Float       @default(1)
  location    String?
  locPosX     Float       @default(50)
  locPosY     Float       @default(20)
  imgPosX     Float       @default(0)
  imgPosY     Float       @default(0)
  imgScale    Float       @default(1)
  imgFit      String      @default("contain")
  visibility  String      @default("public")
  status      String      @default("published")
  views       Int         @default(0)
  likes       Int         @default(0)
  createdAt   DateTime    @default(now())
  expiresAt   DateTime
  shares      Int         @default(0)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyLikes  StoryLike[]
  storyViews  StoryView[]
}

model StoryView {
  id       Int      @id @default(autoincrement())
  storyId  Int
  userId   Int
  viewedAt DateTime @default(now())
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

model StoryLike {
  id      Int      @id @default(autoincrement())
  storyId Int
  userId  Int
  likedAt DateTime @default(now())
  story   Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

model TrendingTopic {
  id    Int    @id
  name  String
  posts String
  image String
}

model SavedCollection {
  id    Int    @id
  name  String
  count Int
  image String
}

model SavedPost {
  id           Int  @id @default(autoincrement())
  userId       Int  @default(1)
  postId       Int
  collectionId Int?
  post         Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

model UserCollection {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  image     String   @default("")
  createdAt DateTime @default(now())
}

model ContentTopic {
  id       String  @id
  label    String
  selected Boolean @default(false)
}

model AnalyticsStat {
  id        Int     @id @default(autoincrement())
  label     String
  value     String
  change    Float
  up        Boolean
  sparkline Float[]
}

model ViewOverTime {
  id    Int    @id @default(autoincrement())
  date  String
  value Int
}

model TopPost {
  id    Int    @id
  title String
  views String
  likes String
  image String
}

model QuickSnapshot {
  id    Int    @id @default(autoincrement())
  label String
  value String
}

model AccountSetting {
  id    Int    @id @default(autoincrement())
  label String
  value String
}

model LanguageRegionSetting {
  id    Int    @id @default(autoincrement())
  label String
  value String
}

model UserExperience {
  id          Int    @id @default(autoincrement())
  userId      Int
  role        String
  company     String
  logo        String @default("")
  period      String
  description String @default("")
  order       Int    @default(0)
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserEducation {
  id     Int    @id @default(autoincrement())
  userId Int
  school String
  degree String
  period String
  logo   String @default("")
  order  Int    @default(0)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSkill {
  id     Int    @id @default(autoincrement())
  userId Int
  name   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model UserInterest {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model UserCustomTab {
  id      Int    @id @default(autoincrement())
  userId  Int
  title   String
  content String @default("")
  order   Int    @default(0)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserHighlight {
  id         Int      @id @default(autoincrement())
  userId     Int
  name       String
  cover      String   @default("")
  images     String[]
  storyCount Int      @default(0)
  order      Int      @default(0)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PostLike {
  id     Int  @id @default(autoincrement())
  postId Int
  userId Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model PostComment {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  text      String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model UserFollow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model BlockedUser {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model UserInvite {
  id          Int      @id @default(autoincrement())
  email       String
  role        UserRole
  token       String   @unique
  status      String   @default("pending")
  invitedById Int
  name        String?
  note        String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime
}

model SocialConnection {
  id                Int             @id @default(autoincrement())
  userId            Int
  platform          String
  platformUserId    String
  platformHandle    String?
  platformAvatarUrl String?
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime?
  webhookSecret     String?
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  messages          SocialMessage[]
  threads           SocialThread[]

  @@unique([userId, platform])
}

model SocialThread {
  id                Int              @id @default(autoincrement())
  connectionId      Int
  externalUserId    String
  externalHandle    String?
  externalAvatarUrl String?
  lastMessageAt     DateTime         @default(now())
  unreadCount       Int              @default(0)
  messages          SocialMessage[]
  connection        SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalUserId])
}

model SocialMessage {
  id            Int              @id @default(autoincrement())
  connectionId  Int
  externalId    String
  fromHandle    String?
  fromAvatarUrl String?
  text          String
  attachmentUrl String?
  read          Boolean          @default(false)
  createdAt     DateTime         @default(now())
  direction     String           @default("inbound")
  threadId      Int?
  connection    SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  thread        SocialThread?    @relation(fields: [threadId], references: [id])

  @@unique([connectionId, externalId])
}

model CircleUpgradeRequest {
  id                Int                         @id @default(autoincrement())
  userId            Int
  accountType       CircleAccountType
  documentType      CircleDocumentType?
  documentNumber    String?
  documentUrl       String?
  status            CircleUpgradeStatus         @default(PENDING)
  fullName          String
  professionalTitle String
  company           String?
  city              String
  district          String?
  country           String?
  pincode           String?
  website           String?
  linkedin          String?
  bio               String?
  reason            String
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  documents         CircleUpgradeDocument[]
  registrations     CircleUpgradeRegistration[]
  user              User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("circle_upgrade_requests")
}

model CircleUpgradeRegistration {
  id                 Int                     @id @default(autoincrement())
  requestId          Int
  registrationType   CircleDocumentType
  registrationNumber String
  createdAt          DateTime                @default(now())
  documents          CircleUpgradeDocument[]
  request            CircleUpgradeRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("circle_upgrade_registrations")
}

model CircleUpgradeDocument {
  id             Int                        @id @default(autoincrement())
  requestId      Int
  registrationId Int?
  documentUrl    String
  documentType   CircleDocumentType
  createdAt      DateTime                   @default(now())
  registration   CircleUpgradeRegistration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  request        CircleUpgradeRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("circle_upgrade_documents")
}

model ActivityLog {
  id        Int               @id @default(autoincrement())
  eventType ActivityEventType
  userId    Int?
  userName  String?
  handle    String?
  avatar    String?
  meta      String?
  createdAt DateTime          @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([eventType])
}

enum ActivityEventType {
  SIGNUP
  SIGNIN
  DEACTIVATE
  REACTIVATE
  DELETE_ACCOUNT
  CIRCLE_REQUEST
  CIRCLE_APPROVED
  CIRCLE_REJECTED
  BAN
  UNBAN
}

enum DomainStatus {
  PENDING
  ACTIVE
  FAILED
}

enum UserRole {
  NORMAL
  CIRCLE
  ADMIN
  AUTHOR
}

enum PostType {
  POST
  ARTICLE
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  MENTION
  LIKE_STORY
  CIRCLE_WELCOME
  CIRCLE_PENDING
}

enum NotificationGroup {
  TODAY
  YESTERDAY
  EARLIER
}

enum CircleUpgradeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CircleAccountType {
  INDIVIDUAL
  COMPANY
}

enum CircleDocumentType {
  AADHAAR
  PAN
  PASSPORT
  DRIVING_LICENSE
  GST
  CERTIFICATE_OF_INCORPORATION
  COMPANY_PAN
  MSME
}
