{
  "name": "template-next-tailwind",
  "version": "0.1.0",
  "private": true,
  "bufferAssigned": false,
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "node scripts/_fix-migration-checksums.mjs && prisma migrate deploy && prisma generate",
    "dev": "next dev --webpack -H 0.0.0.0",
    "prebuild": "node scripts/_fix-migration-checksums.mjs && prisma migrate deploy",
    "build": "prisma generate && next build --webpack",
    "postbuild": "npx prisma db push",
    "prestart": "node scripts/_fix-migration-checksums.mjs && prisma migrate deploy",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:fix-checksums": "node scripts/_fix-migration-checksums.mjs",
    "db:cleanup-duplicates": "node scripts/cleanup-duplicates.js",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:run:android:dev": "cross-env CAPACITOR_SERVER_URL=http://192.168.1.56:3000 npx cap run android --flavor=development",
    "cap:run:android:prod": "npx cap run android --flavor=production",
    "cap:run:ios:dev": "cross-env CAPACITOR_SERVER_URL=http://localhost:3000 npx cap run ios --scheme=development",
    "cap:run:ios:prod": "npx cap run ios --scheme=production",
    "cap:run:android:dev:live": "cross-env CAPACITOR_SERVER_URL=http://192.168.1.56:3000 npx cap run android --flavor=development -l --port=3000",
    "cap:run:ios:dev:live": "cross-env CAPACITOR_SERVER_URL=http://localhost:3000 npx cap run ios --scheme=development -l --port=3000"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@azure/storage-blob": "^12.31.0",
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor-firebase/authentication": "8.3.0",
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capacitor/toast": "^8.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "7.4.1",
    "@prisma/client": "7.4.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@tiptap/core": "^3.21.0",
    "@tiptap/extension-bubble-menu": "^3.21.0",
    "@tiptap/extension-font-family": "^3.21.0",
    "@tiptap/extension-image": "^3.21.0",
    "@tiptap/extension-link": "^3.21.0",
    "@tiptap/extension-placeholder": "^3.21.0",
    "@tiptap/extension-text-align": "^3.21.0",
    "@tiptap/extension-text-style": "^3.21.0",
    "@tiptap/extension-underline": "^3.21.0",
    "@tiptap/extension-youtube": "^3.21.0",
    "@tiptap/pm": "^3.21.0",
    "@tiptap/react": "^3.21.0",
    "@tiptap/starter-kit": "^3.21.0",
    "@types/nodemailer": "^7.0.11",
    "country-state-city": "^3.2.1",
    "d3-geo": "^3.1.1",
    "dotenv": "^17.3.1",
    "firebase": "^12.13.0",
    "firebase-admin": "^14.0.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.563.0",
    "motion-dom": "^12.38.0",
    "next": "16.1.1",
    "next-auth": "beta",
    "nodemailer": "^8.0.4",
    "pg": "^8.19.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-easy-crop": "^5.5.7",
    "react-globe.gl": "^2.37.0",
    "recharts": "^3.8.1",
    "three": "^0.184.0",
    "topojson-client": "^3.1.0",
    "uuid": "^13.0.0"
  },
  "prisma": {
    "seed": "npx ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "@types/topojson-client": "^3.1.5",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.6",
    "prisma": "7.4.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}